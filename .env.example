# Plantilla de variables de la API. Copia este archivo como .env y rellena los valores.
# En producción (Render) añade TODAS estas variables en Environment.
# Nunca subas el .env real a GitHub.

# Puerto de la API (Render pone el suyo automáticamente)
PORT=4000

# Base de datos MySQL. En local: tu MySQL. En producción: los datos de conexión
# de TiDB Cloud (botón "Connect" del cluster), con DB_PORT=4000 y DB_SSL=true.
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=tienda
DB_PORT=3306
DB_SSL=false

# Firma de los tokens. Una cadena larga y aleatoria, distinta en local y en producción.
# Para generar una: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Stripe (modo test): dashboard.stripe.com -> Developers -> API keys
STRIPE_SECRET_KEY=sk_test_...
# En local: lo imprime "stripe listen --forward-to localhost:4000/api/stripe/webhook"
# En producción: el "Signing secret" del endpoint creado en Developers -> Webhooks
STRIPE_WEBHOOK_SECRET=whsec_...

# URL de la web Next.js, SIN barra al final (en producción, la de Vercel)
CORS_ORIGIN=http://localhost:3000

# El MISMO Client ID que usa tienda-next. Sirve para verificar el login con Google.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
